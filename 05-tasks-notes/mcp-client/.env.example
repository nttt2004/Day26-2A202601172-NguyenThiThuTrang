# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env).
#
# Key Gemini — lấy miễn phí tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Gemini dùng cho agent
GEMINI_MODEL=gemini-2.5-flash

# Bearer token phải KHỚP với server_http.py (env TASKS_NOTES_TOKEN bên server).
TASKS_NOTES_TOKEN=dev-token-abc123

# Endpoint MCP server (Bài 2, Streamable HTTP)
MCP_SERVER_URL=http://localhost:8090/mcp
